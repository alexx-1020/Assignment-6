{
  "info": {
    "name": "Recipes API — Assignment 6",
    "description": "Every route of the recipes REST API. Run the two folders in order (Run collection). Change the baseUrl variable if your server is not on http://localhost:3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "recipeId",
      "value": ""
    },
    {
      "key": "secondId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 · CRUD",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "Create a recipe",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('recipeId', pm.response.json()._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/recipes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Mjaddara\",\n  \"cuisine\": \"Lebanese\",\n  \"difficulty\": \"easy\",\n  \"minutes\": 50,\n  \"servings\": 4,\n  \"vegetarian\": true,\n  \"ingredients\": [\n    \"1 cup brown lentils\",\n    \"1/2 cup rice\",\n    \"3 onions\",\n    \"olive oil\",\n    \"salt\"\n  ],\n  \"steps\": [\n    \"Boil the lentils for 15 minutes.\",\n    \"Add the rice and cook until soft.\",\n    \"Fry the onions until dark and serve on top.\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create a second recipe (required fields only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
